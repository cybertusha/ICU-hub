{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://icu-monitor-pro.hospital/schemas/patient.schema.json",
  "title": "Patient",
  "description": "Production ICU Patient Entity Schema",
  "type": "object",
  "required": [
    "patientId",
    "patientName",
    "age",
    "gender",
    "bedNumber",
    "monitoringDeviceId",
    "monitoringStatus",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "patientId": {
      "type": "string",
      "pattern": "^PATIENT-[0-9]{3,}$",
      "description": "Unique ICU patient identifier (e.g., PATIENT-001)"
    },
    "mrn": {
      "type": "string",
      "description": "Hospital Medical Record Number (e.g., MRN-849201)"
    },
    "patientName": {
      "type": "string",
      "minLength": 2,
      "maxLength": 100
    },
    "age": {
      "type": "integer",
      "minimum": 0,
      "maximum": 130
    },
    "gender": {
      "type": "string",
      "enum": ["M", "F", "Other"]
    },
    "bedNumber": {
      "type": "string",
      "pattern": "^ICU-[0-9]{2,}$"
    },
    "monitoringDeviceId": {
      "type": "string"
    },
    "monitoringStatus": {
      "type": "string",
      "enum": ["NORMAL", "WARNING", "CRITICAL", "OFFLINE", "DISCHARGED"]
    },
    "condition": {
      "type": "string"
    },
    "attendingPhysician": {
      "type": "string"
    },
    "primaryNurse": {
      "type": "string"
    },
    "allergies": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "currentMedications": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "careNotes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["noteId", "author", "role", "note", "createdAt"],
        "properties": {
          "noteId": { "type": "string" },
          "author": { "type": "string" },
          "role": { "type": "string" },
          "note": { "type": "string" },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "default": []
    },
    "alertsEnabled": {
      "type": "boolean",
      "default": true
    },
    "admittedAt": {
      "type": "string",
      "format": "date-time"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
